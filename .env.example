# Kannur City Police Sports Facilities Management System
# On-Premise Linux Deployment Configuration

NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# Local On-Premise PostgreSQL 16 Instance
DATABASE_URL="postgresql://kcp_app_user:STRONG_LOCAL_DB_PASSWORD@127.0.0.1:5432/kcp_sports_db?schema=public"

# HTTP-Only Session JWT Configuration
JWT_SECRET="replace-with-64-byte-cryptographically-random-hex-secret-on-premise"
JWT_EXPIRES_IN="8h"
SESSION_COOKIE_NAME="kcp_session"
SESSION_COOKIE_SECURE=true

# Intranet / Web Portal Origin
ALLOWED_ORIGIN="https://sports.kannurpolice.kerala.gov.in"
BCRYPT_SALT_ROUNDS=12
